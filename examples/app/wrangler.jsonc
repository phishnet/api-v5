{
  "name": "phishnet-example-app",
  "main": "worker/index.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*"]
  },
  // 60 requests per minute per IP
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ]
}
